{
  "name": "master-dashboard",
  "version": "1.0.0",
  "description": "Master Dashboard — EternalShine, Monthly Expenses, Universal Pharmacy and Turo in one app",
  "main": "main.js",
  "author": "Riaz",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.riaz.masterdashboard",
    "productName": "Master Dashboard",
    "files": ["main.js", "home.html", "icon.png", "apps/**/*"],
    "mac": {
      "target": ["dir"],
      "icon": "icon.png",
      "category": "public.app-category.business"
    }
  }
}
